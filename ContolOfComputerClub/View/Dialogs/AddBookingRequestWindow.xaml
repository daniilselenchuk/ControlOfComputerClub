<Window x:Class="ControlOfComputerClub.View.Dialogs.AddBookingRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление заявки на бронирование" Height="350" Width="400"
        Icon="\resources\ContactsApp_96x96.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="LightCoral"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID сотрудника:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BookingRequest.EmployeeId, UpdateSourceTrigger=PropertyChanged}" Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ID рабочего места:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BookingRequest.WorkplaceId, UpdateSourceTrigger=PropertyChanged}" Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="ID клиента:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BookingRequest.ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Начало:" Margin="5" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding BookingRequest.StartTime, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Окончание:" Margin="5" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding BookingRequest.EndTime, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Статус заявки:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  SelectedValue="{Binding BookingRequest.RequestStatus, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Content" Margin="5">
            <ComboBoxItem Content="Создана"/>
            <ComboBoxItem Content="Завершена"/>
            <ComboBoxItem Content="Отменена"/>
        </ComboBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Добавить" Width="100" Margin="5" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Margin="5" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>