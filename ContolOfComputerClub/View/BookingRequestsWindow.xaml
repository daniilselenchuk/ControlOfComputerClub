<Window x:Class="ControlOfComputerClub.View.BookingRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ControlOfComputerClub.View.Converters"
        xmlns:viewmodel="clr-namespace:ControlOfComputerClub.ViewModel;assembly=ViewModel"
        Title="Заявки на бронирование" Height="600" Width="800"
        Icon="resources\ContactsApp_96x96.ico"
        d:DataContext="{d:DesignInstance Type=viewmodel:BookingRequestsViewModel}"
        mc:Ignorable="d">

    <Window.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0">
            <Button Content="&lt;&lt;" Command="{Binding FirstBookingRequestCommand}" Width="50" Margin="5"/>
            <Button Content="&lt;" Command="{Binding PreviousBookingRequestCommand}" Width="50" Margin="5"/>
            <TextBlock Text="{Binding CurrentBookingRequest.BookingRequestId}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <Button Content="&gt;" Command="{Binding NextBookingRequestCommand}" Width="50" Margin="5"/>
            <Button Content="&gt;&gt;" Command="{Binding LastBookingRequestCommand}" Width="50" Margin="5"/>
            <Separator Width="1" Height="30" Margin="10,0"/>
            <Button Content="Добавить" Command="{Binding AddBookingRequestCommand}" Width="80" Margin="5"/>
            <Button Content="Сохранить" Command="{Binding SaveBookingRequestCommand}" Width="90" Margin="5"/>
            <Button Content="Удалить" Command="{Binding DeleteBookingRequestCommand}" Width="80" Margin="5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1" Margin="0,5,0,0">
            <TextBlock Text="Фильтр по имени клиента:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding ClientSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Text="Клиент:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <TextBlock Text="{Binding ClientFullName}" VerticalAlignment="Center" Margin="5"/>

            <TextBlock Text="Сотрудник:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <TextBlock Text="{Binding EmployeeFullName}" VerticalAlignment="Center" Margin="5"/>
        </StackPanel>

        <DataGrid x:Name="BookingRequestsGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ItemsSource="{Binding BookingRequests}"
                  SelectedItem="{Binding CurrentBookingRequest, Mode=TwoWay}"
                  SelectionMode="Single"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding BookingRequestId}"
                                    IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="ID сотрудника"
                                    Binding="{Binding EmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>
                <DataGridTextColumn Header="ID рабочего места"
                                    Binding="{Binding WorkplaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>
                <DataGridTextColumn Header="ID клиента"
                                    Binding="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding StartTime, Mode=TwoWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Окончание"
                                    Binding="{Binding EndTime, Mode=TwoWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="2*"/>
                <DataGridComboBoxColumn Header="Статус заявки"
                                        SelectedValueBinding="{Binding RequestStatus, Mode=TwoWay}"
                                        Width="2*">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>Создана</sys:String>
                            <sys:String>Завершена</sys:String>
                            <sys:String>Отменена</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>