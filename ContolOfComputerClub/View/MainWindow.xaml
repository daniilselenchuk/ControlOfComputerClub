<Window x:Class="ControlOfComputerClub.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlOfComputerClub.View" 
        xmlns:viewmodel="clr-namespace:ControlOfComputerClub.ViewModel;assembly=ViewModel" 
        Closing="Window_Closing"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        Icon="resources\ContactsApp_96x96.ico"
        mc:Ignorable="d"
        Title="Главная" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="X" Modifiers="Alt" Command="{Binding ExitCommand}" />
        <KeyBinding Key="I" Modifiers="Alt" Command="{Binding ShowAboutCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Главное меню -->
        <Menu x:Name="Menu" Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Command="{Binding ExitCommand}" 
                          InputGestureText="Alt+X"/>
                <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}" 
                          InputGestureText="Alt+I"/>
            </MenuItem>
        </Menu>

        <!-- Таблица для отображения данных -->
        <DataGrid x:Name="EmployeesGrid" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ItemsSource="{Binding Employees}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeId}" 
                                    Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" 
                                    Width="2*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding JobTitle}" 
                                    Width="2*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" 
                                    Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
