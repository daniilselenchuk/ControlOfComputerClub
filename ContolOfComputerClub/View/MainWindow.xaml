<Window x:Class="ControlOfComputerClub.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlOfComputerClub.View" 
        xmlns:viewmodel="clr-namespace:ControlOfComputerClub.ViewModel;assembly=ViewModel" 
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="X" Modifiers="Alt" Command="{Binding ExitCommand}" />
        <KeyBinding Key="I" Modifiers="Alt" Command="{Binding ShowAboutCommand}" />
    </Window.InputBindings>
    
    <Grid>
        <Menu>
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Command="{Binding ExitCommand}" 
                          InputGestureText="Alt+X"/>
                <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}" 
                          InputGestureText="Alt+I"/>
            </MenuItem>
        </Menu>
    </Grid>
</Window>
