<Window x:Class="View.EntranceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Icon="resources\ContactsApp_96x96.ico"
        Title="Вход" Height="250" Width="400">
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Логин:" FontSize="14"/>
            <TextBox x:Name="LoginTextbox" FontSize="14" Margin="0,5,0,10"/>

            <TextBlock Text="Пароль:" FontSize="14"/>
            <PasswordBox x:Name="PasswordBox" FontSize="14" Margin="0,5,0,20"/>

            <Button Content="Войти" FontSize="14" Padding="10,5" 
                Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
