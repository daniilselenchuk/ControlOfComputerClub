<Window x:Class="ControlOfComputerClub.View.Dialogs.AddBookingRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление заявки на бронирование"
        Icon="\resources\ContactsApp_96x96.ico"
        Height="350" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="LightCoral"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5"
                   VerticalAlignment="Center" Text="Сотрудник:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5"
                 Text="{Binding BookingRequest.EmployeeId, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ValidationTextBoxStyle}"/>
        <Button Grid.Row="0" Grid.Column="2" Margin="2"
                Content="…" Command="{Binding OpenEmployeeSelectionCommand}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5"
                   VerticalAlignment="Center" Text="Раб. место:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                 Text="{Binding BookingRequest.WorkplaceId, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ValidationTextBoxStyle}"/>
        <Button Grid.Row="1" Grid.Column="2" Margin="2"
                Content="…" Command="{Binding OpenWorkplaceSelectionCommand}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
                   VerticalAlignment="Center" Text="Клиент:"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                 Text="{Binding BookingRequest.ClientId, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ValidationTextBoxStyle}"/>
        <Button Grid.Row="2" Grid.Column="2" Margin="2"
                Content="…" Command="{Binding OpenClientSelectionCommand}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" Text="Начало:"/>
        <DatePicker Grid.Row="3" Grid.Column="1" Margin="5"
                    SelectedDate="{Binding BookingRequest.StartTime, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="Окончание:"/>
        <DatePicker Grid.Row="4" Grid.Column="1" Margin="5"
                    SelectedDate="{Binding BookingRequest.EndTime, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="5" Text="Статус:"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="5"
                  SelectedValuePath="Content"
                  SelectedValue="{Binding BookingRequest.RequestStatus, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="Создана"/>
            <ComboBoxItem Content="Завершена"/>
            <ComboBoxItem Content="Отменена"/>
        </ComboBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Добавить" Width="100" Margin="5"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="100" Margin="5"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>