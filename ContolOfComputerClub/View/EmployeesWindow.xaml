<Window x:Class="ControlOfComputerClub.View.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ControlOfComputerClub.View.Converters"
        xmlns:viewmodel="clr-namespace:ControlOfComputerClub.ViewModel;assembly=ViewModel"
        Title="Сотрудники" Height="450" Width="800"
        Icon="resources\ContactsApp_96x96.ico"
        d:DataContext="{d:DesignInstance Type=viewmodel:EmployeesViewModel}"
        mc:Ignorable="d">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="LightCoral"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель навигации и операций -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Button Content="&lt;&lt;" Command="{Binding FirstEmployeeCommand}" Width="50" Margin="5"/>
            <Button Content="&lt;" Command="{Binding PreviousEmployeeCommand}" Width="50" Margin="5"/>
            <TextBlock Text="{Binding CurrentEmployee.EmployeeId}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <Button Content="&gt;" Command="{Binding NextEmployeeCommand}" Width="50" Margin="5"/>
            <Button Content="&gt;&gt;" Command="{Binding LastEmployeeCommand}" Width="50" Margin="5"/>
            <Separator Margin="10,0" Width="1" Height="30"/>
            <Button Content="Добавить" Command="{Binding AddEmployeeCommand}"
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" Width="80" Margin="5"/>
            <Button Content="Сохранить" Command="{Binding SaveEmployeeCommand}"
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" Width="90" Margin="5"/>
            <Button Content="Удалить" Command="{Binding DeleteEmployeeCommand}"
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" Width="80" Margin="5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID сотрудника:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEmployee.EmployeeId}" Margin="5" IsReadOnly="True"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEmployee.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Телефон:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEmployee.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Должность:" Margin="5" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="3" Grid.Column="1"
                      SelectedValue="{Binding CurrentEmployee.JobTitle, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                      SelectedValuePath="Content"
                      Margin="5">
                <ComboBoxItem Content="Администратор"/>
                <ComboBoxItem Content="Кассир"/>
            </ComboBox>


            <TextBlock Grid.Row="4" Grid.Column="0" Text="Паспорт:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentEmployee.NumberPassport, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Фото:" Margin="5" VerticalAlignment="Center"/>
            <Image Grid.Row="5" Grid.Column="1" Margin="5" 
                   Source="{Binding CurrentEmployee.Photo, Converter={StaticResource ByteArrayToImageConverter}}"/>
            <Border Grid.Row="7" Grid.Column="5" Margin="5" BorderThickness="1" BorderBrush="Gray"/>
            <Button Grid.Column="0" Grid.Row="6" Content="Загрузить фото" Command="{Binding LoadEmployeePhotoCommand}" Width="120" Height="30"/>
        </Grid>
    </Grid>
</Window>