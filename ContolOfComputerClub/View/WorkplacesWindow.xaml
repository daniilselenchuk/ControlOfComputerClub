<Window x:Class="ControlOfComputerClub.View.WorkplacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlOfComputerClub.View"
        xmlns:converters="clr-namespace:ControlOfComputerClub.View.Converters"
        xmlns:viewmodel="clr-namespace:ControlOfComputerClub.ViewModel;assembly=ViewModel"
        Title="Рабочие места" Height="450" Width="800"
        Icon="resources\ContactsApp_96x96.ico"
        d:DataContext="{d:DesignInstance Type=viewmodel:WorkplacesViewModel}"
        mc:Ignorable="d">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <Style x:Key="ValidationTextBoxStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="LightCoral"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Button Content="&lt;&lt;" Command="{Binding FirstWorkplaceCommand}" Width="50" Margin="5"/>
            <Button Content="&lt;" Command="{Binding PreviousWorkplaceCommand}" Width="50" Margin="5"/>
            <TextBlock Text="{Binding CurrentWorkplace.WorkplaceId}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <Button Content="&gt;" Command="{Binding NextWorkplaceCommand}" Width="50" Margin="5"/>
            <Button Content="&gt;&gt;" Command="{Binding LastWorkplaceCommand}" Width="50" Margin="5"/>

            <Separator Margin="10,0" Width="1" Height="30"/>

            <Button Content="Добавить" Command="{Binding AddWorkplaceCommand}" 
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" 
                    Width="80" Margin="5"/>
            <Button Content="Сохранить" Command="{Binding SaveWorkplaceCommand}" 
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" 
                    Width="90" Margin="5"/>
            <Button Content="Удалить" Command="{Binding DeleteWorkplaceCommand}" 
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBoolConverter}}" 
                    Width="80" Margin="5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID рабочего места:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentWorkplace.WorkplaceId}" 
                     Margin="5" IsReadOnly="True"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус:" Margin="5" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1"
                      IsChecked="{Binding CurrentWorkplace.Status, UpdateSourceTrigger=PropertyChanged}"
                      Content="Активен"
                      Margin="5"/>
            
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Тариф:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding CurrentWorkplace.Tariff, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена рабочего места:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" 
                     Text="{Binding CurrentWorkplace.PriceOfWorkplace, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Конфигурация:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     Text="{Binding CurrentWorkplace.Configuration, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                     Margin="5" Style="{StaticResource ValidationTextBoxStyle}"/>
        </Grid>
    </Grid>
</Window>